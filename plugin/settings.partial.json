{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/basin-session-start.sh", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.claude/hooks/basin-precompact.sh", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.claude/hooks/basin-session-end.sh", "timeout": 10 } ] }
    ]
  }
}
